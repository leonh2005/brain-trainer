<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.steven.ollama-progress</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/steven/CCProject/ollama-progress/overlay.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>WatchPaths</key>
	<array>
		<string>/opt/homebrew/var/log/ollama.log</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/steven/Library/Logs/ollama-progress.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/steven/Library/Logs/ollama-progress.err.log</string>
</dict>
</plist>
